# Copy to .env.local and fill in. Never commit .env.local.

# Postgres (local Docker: see docker-compose.yml; started with `npm run db:up`)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=smooth_scheduling
# Must match the values above, e.g. postgres://postgres:<password>@localhost:5432/smooth_scheduling
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (calendar scopes + offline access)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
